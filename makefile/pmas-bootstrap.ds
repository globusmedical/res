#!@duckscript
# PMAS bootstrap v2. Canonical text: globusmedical/res, makefile/pmas-bootstrap.ds.
# Copy verbatim into `[config] load_script`; the task set it fetches warns when
# this copy falls behind. Rationale and options: res/README.md.
set_env PMAS_BOOTSTRAP_VERSION 2
dir = set "${CARGO_MAKE_WORKSPACE_WORKING_DIRECTORY}"
etag = set "${dir}/target/cargo-make/pmas.etag"
mkdir ${dir}/makefile
mkdir ${dir}/target/cargo-make
touch ${etag}
exec curl -m 10 --fail --etag-compare "${etag}" --etag-save "${etag}" -L "https://github.com/globusmedical/res/raw/refs/heads/main/makefile/Makefile-pmas.toml" -o "${dir}/makefile/Makefile.toml"
