*.zip filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text

# The bootstrap is copied verbatim into consumer repositories and its version
# file is parsed by the copy, so neither should pick up CRLF on checkout.
makefile/pmas-bootstrap.ds text eol=lf
makefile/pmas-bootstrap.version text eol=lf
