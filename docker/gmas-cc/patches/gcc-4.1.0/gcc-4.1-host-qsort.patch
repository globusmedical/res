Link the Cygwin 1.7.1 (newlib) qsort into native Windows host programs.

GCC and binutils sort with comparators that return 0 for distinct elements,
so their output depends on the host qsort.  The original GMAS toolchain ran on
Cygwin 1.7.1; using its exact qsort makes the mingw-hosted tools produce
byte-identical objects and executables.  See libiberty/host-qsort.c.

--- a/libiberty/Makefile.in
+++ b/libiberty/Makefile.in
@@ -168,7 +168,7 @@
 	./fdmatch.o ./fibheap.o ./floatformat.o ./fnmatch.o		\
 	 ./fopen_unlocked.o						\
 	./getopt.o ./getopt1.o ./getpwd.o ./getruntime.o		\
-	./hashtab.o ./hex.o						\
+	./hashtab.o ./hex.o ./host-qsort.o					\
 	./lbasename.o ./lrealpath.o					\
 	./make-relative-prefix.o ./make-temp-file.o			\
 	./objalloc.o ./obstack.o					\
@@ -1088,6 +1088,12 @@
 	else true; fi
 	$(COMPILE.c) $(srcdir)/xmalloc.c $(OUTPUT_OPTION)
 
+./host-qsort.o: $(srcdir)/host-qsort.c
+	if [ x"$(PICFLAG)" != x ]; then \
+	  $(COMPILE.c) $(PICFLAG) $(srcdir)/host-qsort.c -o pic/$@; \
+	else true; fi
+	$(COMPILE.c) $(srcdir)/host-qsort.c $(OUTPUT_OPTION)
+
 ./xmemdup.o: $(srcdir)/xmemdup.c config.h $(INCDIR)/ansidecl.h \
 	$(INCDIR)/libiberty.h
 	if [ x"$(PICFLAG)" != x ]; then \
--- a/libiberty/host-qsort.c
+++ b/libiberty/host-qsort.c
@@ -0,0 +1,243 @@
+/* qsort for native Windows hosts, identical to the one in Cygwin 1.7.1.
+
+   The original GMAS cross compiler ran on Cygwin 1.7.1 and therefore used
+   newlib's qsort.  GCC sorts with comparators that can return 0 for distinct
+   elements (e.g. stack_var_size_cmp in cfgexpand.c), so the resulting order,
+   and with it the generated code, depends on the qsort implementation.  To
+   produce byte-identical output to that compiler, native Windows builds link
+   this copy instead of msvcrt's qsort.
+
+   The code below is newlib/libc/search/qsort.c from the newlib-cygwin
+   repository at tag cygwin-1_7_1-release, unchanged except for replacing
+   <_ansi.h>/<stdlib.h> with the definitions it needs.  */
+
+#if defined (_WIN32) && !defined (__CYGWIN__)
+
+/*
+FUNCTION
+<<qsort>>---sort an array
+
+INDEX
+	qsort
+
+ANSI_SYNOPSIS
+	#include <stdlib.h>
+	void qsort(void *<[base]>, size_t <[nmemb]>, size_t <[size]>,
+		   int (*<[compar]>)(const void *, const void *) );
+
+TRAD_SYNOPSIS
+	#include <stdlib.h>
+	qsort(<[base]>, <[nmemb]>, <[size]>, <[compar]> )
+	char *<[base]>;
+	size_t <[nmemb]>;
+	size_t <[size]>;
+	int (*<[compar]>)();
+
+DESCRIPTION
+<<qsort>> sorts an array (beginning at <[base]>) of <[nmemb]> objects.
+<[size]> describes the size of each element of the array.
+
+You must supply a pointer to a comparison function, using the argument
+shown as <[compar]>.  (This permits sorting objects of unknown
+properties.)  Define the comparison function to accept two arguments,
+each a pointer to an element of the array starting at <[base]>.  The
+result of <<(*<[compar]>)>> must be negative if the first argument is
+less than the second, zero if the two arguments match, and positive if
+the first argument is greater than the second (where ``less than'' and
+``greater than'' refer to whatever arbitrary ordering is appropriate).
+
+The array is sorted in place; that is, when <<qsort>> returns, the
+array elements beginning at <[base]> have been reordered.
+
+RETURNS
+<<qsort>> does not return a result.
+
+PORTABILITY
+<<qsort>> is required by ANSI (without specifying the sorting algorithm).
+*/
+
