Expand @file response-file arguments in the gcc driver, as gcc 4.2 does.
CMake's Ninja generator links through a response file; Cygwin used to expand
it before the driver started, a native Windows driver has to do it itself.

--- a/gcc/gcc.c
+++ b/gcc/gcc.c
@@ -6025,6 +6025,8 @@
   const char *p;
   struct user_specs *uptr;
 
+  expandargv (&argc, (char ***) &argv);
+
   p = argv[0] + strlen (argv[0]);
   while (p != argv[0] && !IS_DIR_SEPARATOR (p[-1]))
     --p;
